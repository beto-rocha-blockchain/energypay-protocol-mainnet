PORT=3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Auth
JWT_SECRET=replace-with-long-random-secret
MASTER_ENCRYPTION_KEY=replace-with-long-random-secret

# Stellar network: "mainnet" for production (default). Set to "testnet" only for local development.
STELLAR_NETWORK=mainnet

# Stellar custody account used for XLM settlement payments.
STELLAR_SECRET=SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional fallback destination for legacy /api/settlement/execute calls
# that do not pass recipient_public_key.
STELLAR_DESTINATION=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# EPWR issuer/distribution accounts for issued-asset settlements.
ISSUER_SECRET=SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DISTRIBUTION_SECRET=SBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EPWR_ISSUER_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EPWR_PRICE_XLM=1

# x402-compatible paid API flow
X402_RECEIVER_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
X402_PRICE_XLM=0.0001
X402_MEMO=X402-PLD
# X402_NETWORK is derived automatically from STELLAR_NETWORK above

# Email service (Resend — https://resend.com)
# Without a verified domain, Resend delivers ONLY to the account owner's email and
# you must keep the default sender (onboarding@resend.dev). To email ANY recipient
# (production), verify a domain at https://resend.com/domains and set RESEND_FROM_EMAIL
# to an address on it.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=EnergyPay <noreply@yourdomain.com>

# Public URLs used to build email verify/reset links. Set BOTH on Vercel:
#   SITE_URL     = origin that serves /api/auth/verify-email (the backend/site)
#   FRONTEND_URL = origin of the web app (where /reset-password lives)
SITE_URL=https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Phone OTP — account confirmation + password-reset 2FA, via Twilio.
# OTP_CHANNEL: "whatsapp" (default; free sandbox for testing) or "sms".
#   · WhatsApp sandbox: each recipient must first message your sandbox join code.
#   · SMS: requires a Twilio phone number in TWILIO_SMS_FROM (no opt-in needed).
# If the channel is unset, phone OTP is disabled: in development the code is
# logged/returned for testing; in production sending fails safely (never leaked).
OTP_CHANNEL=whatsapp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+12025550123

# Billing & Subscriptions (Asaas)
# Payment gateway for SaaS subscription billing (PIX + credit card + boleto).
# SANDBOX (test) is the DEFAULT — real money/KYC only when SANDBOX=false.
# Free sandbox key: https://sandbox.asaas.com → Configuracoes → Integracoes → API Key
PAYMENT_GATEWAY=asaas
PAYMENT_GATEWAY_KEY=replace-with-asaas-SANDBOX-api-key
PAYMENT_GATEWAY_SANDBOX=true

# Crypto subscription billing (optional — isolated, read-only Horizon verification).
# Dedicated treasury that RECEIVES XLM/USDC. Only the PUBLIC key here; secret stays offline.
ENERGY_PAY_TREASURY_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
USDC_ASSET_CODE=USDC
# Canonical Circle USDC issuer on Stellar Mainnet — VERIFY before production use.
USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Fiscal documents: NONE = payment receipts only (no official NF-e/NFS-e yet).
FISCAL_PROVIDER=NONE
